# Values prefixed with NEXT_PUBLIC_ are included in the browser bundle. Only
# use credentials specifically intended to be public, and restrict them by
# domain/API in their provider console.
NEXT_PUBLIC_FIREBASE_WEB_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=

# Server-only Firebase Admin configuration. Keep the service-account JSON file
# outside version control. Firebase Hosting provides credentials automatically.
GOOGLE_APPLICATION_CREDENTIALS=./lib/firebase/dekitabi-service-account.json
GOOGLE_CLOUD_PROJECT=dekitabi
